# SIH 26067 | Ocean Intelligence Platform — Development Environment
#
# VITE_DATA_SOURCE controls which data layer is used:
#   api  — calls the FastAPI backend (requires: uvicorn app.main:app --port 8000)
#   mock — uses the built-in demo data (no backend needed, always works)
#
VITE_API_BASE_URL=http://localhost:8000
VITE_DATA_SOURCE=api
